# .env holds secrets only. Everything else (provider, models, base URLs)
# has a working default in curriculum_agent/config.py — override here only
# if your local setup differs.

# --- Docker service credentials (required: docker compose refuses to start
# --- without them) ---
POSTGRES_PASSWORD=change-me
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
# Only needed when running `docker compose --profile debug up`
# PGADMIN_PASSWORD=change-me

# On a fresh postgres-data volume, this must carry the same password as
# POSTGRES_PASSWORD above (POSTGRES_PASSWORD only seeds the password when
# Postgres first initialises its data directory). Rotating the password
# against an EXISTING volume is a different, ordered procedure — see
# docs/demo-runbook.md "Before the demo" step 3. Do not just edit this line
# and POSTGRES_PASSWORD independently; that starts a stack the app can't log
# into.
# POSTGRES_DSN=postgresql+asyncpg://curriculum:change-me@127.0.0.1:5432/curriculum_agent

# --- LLM ---
# Five slots, each named after the stage that calls it, listed here in the order
# the pipeline runs them: extraction, clustering, need_combination,
# plo_synthesis, validation. That is also the order the API prints at startup.
#
# The old names (HEAVY_*, SYNTHESIS_*, LIGHT_MODEL) are refused rather than
# ignored: Settings ignores unknown keys, so a .env still carrying one would be
# a line nobody reads, and the run would start on a provider default while the
# operator believed they had selected a model. Settings() now raises and names
# the replacement.
#
# LLM_PROVIDER is the fallback for any slot left unset, and nothing else. The
# default is "opentyphoon" — Thai-first models, since every prompt and every
# stored statement in this pipeline is Thai. "openrouter" and "ollama" (local,
# no key) are the alternatives.
OPENTYPHOON_API_KEY=your-key-here     # required unless you switch LLM_PROVIDER
# LLM_PROVIDER=openrouter
#
# Skill extraction has its own knob because it fans out one call per window of
# every evidence item, so it is what exhausts a provider's token quota first —
# and it exhausted the Thai endpoint's. It now ships on OpenRouter; set this to
# opentyphoon to put the whole pipeline back on one endpoint.
# EXTRACTION_PROVIDER=openrouter
# EXTRACTION_MODEL=meta-llama/llama-3.3-70b-instruct
#
# Clustering runs on its own endpoint. It holds a whole KSEC bucket of skills in
# one context and reasons over it, which is what a 30B Thai-first model is
# weakest at, and it returns a grouping rather than prose, so there is nothing
# Thai to lose by moving it. Both keys are therefore needed in the shipped
# configuration. Set CLUSTERING_PROVIDER to the same value as LLM_PROVIDER to
# run the whole pipeline on one endpoint instead.
OPENROUTER_API_KEY=your-key-here      # required unless you move CLUSTERING_PROVIDER
# CLUSTERING_PROVIDER=openrouter
# CLUSTERING_MODEL=meta-llama/llama-3.3-70b-instruct
#
# need_combination writes the Thai sentence for each Need — the one sentence
# plo_synthesis is later handed. It ships with its provider unset, so it follows
# LLM_PROVIDER: the Thai-first default is a property of that setting, and this
# slot's job is to inherit it rather than to pin whatever it resolves to today.
# NEED_COMBINATION_PROVIDER=opentyphoon
# NEED_COMBINATION_MODEL=typhoon-v2.5-30b-a3b-instruct
#
# PLO synthesis is its own slot, not part of clustering. The two were one slot
# until they had to go different ways: clustering wants the larger model, while
# a PLO statement is Thai that a curriculum designer submits to MHESI under
# their own name. It stays on the Thai endpoint, and it is cheap enough to — at
# most four calls per PLO, against extraction's one per window of every evidence
# item. Both the draft call and the SMART repair call go through it.
# PLO_SYNTHESIS_PROVIDER=opentyphoon
# PLO_SYNTHESIS_MODEL=typhoon-v2.5-30b-a3b-instruct
#
# The SMART validation agent is its own slot, and deliberately not clustering's:
# a slot sharing that knob could not be moved without moving clustering. It is
# the only slot that runs a tool-using multi-turn loop, and it defaults to
# OpenRouter (the same model family as clustering) because the loop reasons over
# a Thai sentence plus a set of tool results rather than writing Thai: when it
# decides a statement must be repaired it emits an instruction and
# PLO_SYNTHESIS_MODEL rewrites the sentence, so a repair is still never answered
# by a different model than wrote the draft.
# It needs no new key — OPENROUTER_API_KEY above already covers it.
#
# It is the most expensive slot per PLO (one draft plus up to
# VALIDATION_MAX_TURNS turns plus up to VALIDATION_MAX_REPAIRS repair drafts,
# against the previous five calls). Set VALIDATION_PROVIDER to *nothing* to skip
# the agent and keep the pure-code verdict — that is the kill switch, and it
# reuses the fallback an endpoint outage needs anyway rather than a flag.
#
# Empty and commented-out are different here, and only here. `VALIDATION_PROVIDER=`
# with nothing after it switches the agent off; commenting the line out means
# "follow LLM_PROVIDER", the same as for every other slot. Every other slot only
# picks a provider, so it has no third state to express.
#   VALIDATION_PROVIDER=          <- off, verdicts are pure code (smart_validated_by=code_only)
# VALIDATION_PROVIDER=openrouter
# VALIDATION_MODEL=meta-llama/llama-3.3-70b-instruct
# VALIDATION_MAX_TURNS=8
# VALIDATION_MAX_REPAIRS=3
# VALIDATION_MAX_CONCURRENT_PLOS=3      # agent loops in flight, not calls
# VALIDATION_TIMEOUT_SECONDS=240        # per PLO; bounds the whole stage

# --- Demo serving (see docs/demo-runbook.md) ---
# SERVE_FRONTEND and CORS_ORIGINS below are set as process environment
# variables by scripts/start-demo.ps1, not read from .env — do NOT uncomment
# them here. settings.serve_frontend is read once at import time and shared by
# every process that imports the app, including `uv run pytest`: if
# frontend/dist happens to exist, tests/unit/test_api_main_wiring.py fails;
# if it does not, mount_frontend raises RuntimeError at collection.
# SERVE_FRONTEND=true
# CORS_ORIGINS=[]
#
# API_KEY must stay UNSET for the demo — the frontend sends no X-API-Key
# header, so setting this 401s every write (save, classify, checkpoint
# approve/reject). Uncommenting the line below "to be safe" breaks the demo;
# see docs/demo-runbook.md.
# API_KEY=change-me-in-production
